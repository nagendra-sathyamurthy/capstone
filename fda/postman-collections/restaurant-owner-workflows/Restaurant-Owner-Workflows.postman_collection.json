{
  "info": {
    "_postman_id": "restaurant-owner-workflows-001",
    "name": "Restaurant Owner Workflows",
    "description": "Complete workflow collection for restaurant owners to manage their restaurants and menu items in the food delivery system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "restaurant_id",
