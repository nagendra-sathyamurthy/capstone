						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Order accepted successfully\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"OrderAcceptedEvent should be published\", function () {",
									"    // This event should trigger:",
									"    // 1. Customer notification: 'Your order has been accepted'",
									"    // 2. Kitchen preparation workflow",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    console.log('✓ OrderAcceptedEvent published for order: ' + pm.environment.get('order_id'));",
									"});"
								],
								"type": "text/javascript"
							}
						}
