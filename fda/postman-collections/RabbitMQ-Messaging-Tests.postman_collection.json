						"url": {
							"raw": "{{BASE_URL}}/api/order/{{order_id}}/status",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "order", "{{order_id}}", "status"]
						},
						"description": "Updates order status to Delivered (status code 6)"
