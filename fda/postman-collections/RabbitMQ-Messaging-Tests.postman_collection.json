					"name": "Update Order Status to Delivered (Publishes OrderDeliveredEvent)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Order marked as delivered\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"OrderDeliveredEvent should be published\", function () {",
									"    // This event should trigger:",
									"    // 1. Customer notification: Delivery confirmation",
									"    // 2. Payment settlement",
									"    // 3. Rating/feedback request",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    console.log('✓ OrderDeliveredEvent published');",
									"    console.log('✓ Order lifecycle complete');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
