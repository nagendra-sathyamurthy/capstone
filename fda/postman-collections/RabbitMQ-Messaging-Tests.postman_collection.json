{
	"info": {
		"_postman_id": "rabbitmq-messaging-test",
		"name": "RabbitMQ Messaging Tests",
		"description": "Test collection for RabbitMQ message-oriented middleware implementation.\n\nTests event publishing and consumption across Order, Payment, and Cart services.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login as Operator",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Login successful\", function () {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('token');",
									"    pm.environment.set('auth_token', jsonData.token);",
									"    pm.environment.set('user_id', jsonData.userId);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"operator.pizzapalace@example.com\",\n    \"password\": \"Operator123!\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/authentication/login",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "authentication", "login"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Order Events",
			"item": [
				{
					"name": "Create Order (Publishes OrderCreatedEvent)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Order created successfully\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response contains order ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.a('string');",
									"    pm.expect(jsonData.length).to.be.greaterThan(0);",
									"    pm.environment.set('order_id', jsonData);",
									"});",
									"",
									"pm.test(\"OrderCreatedEvent should be published to RabbitMQ\", function () {",
									"    // This event should trigger:",
									"    // 1. Payment processing (when Payment service is implemented)",
									"    // 2. Customer notification (when CRM service is implemented)",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    console.log('✓ OrderCreatedEvent published for order: ' + pm.environment.get('order_id'));",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"customerId\": \"{{user_id}}\",\n    \"restaurantId\": \"rest-001\",\n    \"restaurantName\": \"Pizza Palace\",\n    \"items\": [\n        {\n            \"menuItemId\": \"item-001\",\n            \"name\": \"Margherita Pizza\",\n            \"quantity\": 2,\n            \"price\": 299.99,\n            \"specialInstructions\": \"Extra cheese\"\n        },\n        {\n            \"menuItemId\": \"item-002\",\n            \"name\": \"Garlic Bread\",\n            \"quantity\": 1,\n            \"price\": 99.99,\n            \"specialInstructions\": \"\"\n        }\n    ],\n    \"totalAmount\": 699.97\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/order",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "order"]
						}
					},
					"response": []
				},
				{
					"name": "Accept Order (Publishes OrderAcceptedEvent)",
