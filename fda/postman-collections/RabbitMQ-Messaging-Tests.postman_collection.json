						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Order declined successfully\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"OrderDeclinedEvent should be published\", function () {",
									"    // This event should trigger:",
									"    // 1. Customer notification with reason",
									"    // 2. Refund initiation if payment was made",
									"    // 3. Alternative restaurant suggestions",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    console.log('✓ OrderDeclinedEvent published');",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
