		{
			"name": "Cart Events",
			"item": [
				{
					"name": "Simulate PaymentCompleted (Should Clear Cart)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Payment completed simulation\", function () {",
									"    // Note: This is a placeholder for when Payment service is implemented",
									"    // When Payment service publishes PaymentCompletedEvent,",
									"    // Cart service should automatically clear the customer's cart",
									"    console.log('When PaymentCompletedEvent is published:');",
									"    console.log('  1. Cart service receives event via RabbitMQ');",
									"    console.log('  2. CartMessageConsumerService processes event');",
									"    console.log('  3. Customer cart is cleared automatically');",
									"    console.log('  4. No manual cart clearing needed');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/cart/{{user_id}}",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "cart", "{{user_id}}"]
						},
						"description": "Check cart status - will be automatically cleared when PaymentCompletedEvent is published"
					},
					"response": []
				}
			]
		},
		{
			"name": "RabbitMQ Management",
			"item": [
				{
					"name": "Get RabbitMQ Queues Info",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"RabbitMQ Management API accessible\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Expected queues exist\", function () {",
									"    var queues = pm.response.json();",
									"    var queueNames = queues.map(q => q.name);",
									"    ",
									"    // Check for service queues",
									"    pm.expect(queueNames).to.include('order-service-queue');",
									"    pm.expect(queueNames).to.include('cart-service-queue');",
									"    ",
									"    console.log('Found queues:', queueNames);",
									"    ",
									"    queues.forEach(function(queue) {",
									"        console.log(`Queue: ${queue.name}, Messages: ${queue.messages}, Consumers: ${queue.consumers}`);",
									"    });",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "admin",
									"type": "string"
								},
								{
									"key": "password",
									"value": "AdminPass2024",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{RABBITMQ_MANAGEMENT_URL}}/api/queues",
							"host": ["{{RABBITMQ_MANAGEMENT_URL}}"],
							"path": ["api", "queues"]
						},
						"description": "Get list of all RabbitMQ queues and their status"
					},
					"response": []
				},
				{
					"name": "Get Exchange Bindings",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Exchange bindings retrieved\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Food delivery exchange exists and has bindings\", function () {",
									"    var bindings = pm.response.json();",
									"    console.log('Exchange bindings:', JSON.stringify(bindings, null, 2));",
									"    ",
									"    // Verify routing keys are set up correctly",
									"    var routingKeys = bindings.map(b => b.routing_key);",
									"    console.log('Routing keys:', routingKeys);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "admin",
									"type": "string"
								},
								{
									"key": "password",
									"value": "AdminPass2024",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{RABBITMQ_MANAGEMENT_URL}}/api/exchanges/%2F/food-delivery-exchange/bindings/source",
							"host": ["{{RABBITMQ_MANAGEMENT_URL}}"],
							"path": ["api", "exchanges", "%2F", "food-delivery-exchange", "bindings", "source"]
