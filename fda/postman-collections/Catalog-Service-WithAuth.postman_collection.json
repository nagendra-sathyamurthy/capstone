{
  "info": {
    "name": "Catalog Service API (With Auth)",
    "description": "API collection for Catalog Service with authentication support",
    "version": "2.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "{{catalog_base_url}}",
      "type": "string"
    },
    {
      "key": "auth_url",
      "value": "{{auth_base_url}}",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "itemId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Add Authorization header to each request using collection variable",
          "const token = pm.collectionVariables.get('auth_token');",
          "if (token && token !== '') {",
          "    pm.request.headers.add({",
          "        key: 'Authorization',",
          "        value: `Bearer ${token}`",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Setup - Register Test User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User registered or already exists', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123!\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"phoneNumber\": \"+1-555-0100\",\n  \"role\": 0,\n  \"organization\": \"external_users\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/api/auth/register",
          "host": ["{{auth_url}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Register test user for authentication"
      }
    },
    {
      "name": "1. Login and Get Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login successful', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Token received', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('token');",
              "    pm.collectionVariables.set('auth_token', jsonData.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123!\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/api/auth/login",
          "host": ["{{auth_url}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Login to get authentication token"
      }
    },
    {
      "name": "Get All Items",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is array', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/item",
          "host": ["{{baseUrl}}"],
          "path": ["api", "item"]
        },
        "description": "Retrieve all items from the catalog"
      }
    },
    {
      "name": "Create Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Item created successfully', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const response = pm.response.json();",
              "    if (response.id) {",
              "        pm.collectionVariables.set('itemId', response.id);",
              "        pm.test('Item ID received', function () {",
              "            pm.expect(response.id).to.exist;",
              "        });",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Margherita Pizza (Large)\",\n  \"description\": \"Fresh mozzarella cheese, San Marzano tomatoes, fresh basil leaves\",\n  \"price\": 18.99,\n  \"category\": \"Pizza\",\n  \"restaurant\": \"Tony's Authentic Pizzeria\",\n  \"sku\": \"PIZZA-MARG-LG\",\n  \"availability\": true,\n  \"preparationTime\": 15,\n  \"servingSize\": \"2-3 people\",\n  \"calories\": 285\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/item",
          "host": ["{{baseUrl}}"],
          "path": ["api", "item"]
        },
        "description": "Create a new item in the catalog"
      }
    },
    {
      "name": "Get Item by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Item has required fields', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('name');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/item/{{itemId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "item", "{{itemId}}"]
        },
        "description": "Retrieve a specific item by its ID"
      }
    },
    {
      "name": "Create Multiple Items (Bulk)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Bulk create successful', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"name\": \"Chicken Tikka Masala\",\n    \"description\": \"Tender chicken pieces in creamy curry sauce\",\n    \"price\": 16.95,\n    \"category\": \"Indian Curry\",\n    \"restaurant\": \"Spice Garden\",\n    \"sku\": \"CURRY-TIKKA-REG\",\n    \"availability\": true\n  },\n  {\n    \"name\": \"California Sushi Roll\",\n    \"description\": \"Fresh avocado, cucumber, and crab\",\n    \"price\": 12.50,\n    \"category\": \"Sushi\",\n    \"restaurant\": \"Sakura Sushi Bar\",\n    \"sku\": \"SUSHI-CALIF-8PC\",\n    \"availability\": true\n  }\n]"
        },
        "url": {
          "raw": "{{baseUrl}}/api/item/bulk",
          "host": ["{{baseUrl}}"],
          "path": ["api", "item", "bulk"]
        },
        "description": "Create multiple items in a single request"
      }
    },
    {
      "name": "Update Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Item updated successfully', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Pizza Name\",\n  \"description\": \"Updated description\",\n  \"price\": 19.99\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/item/{{itemId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "item", "{{itemId}}"]
        },
        "description": "Update an existing item"
      }
    },
    {
      "name": "Delete Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Item deleted successfully', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/item/{{itemId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "item", "{{itemId}}"]
        },
        "description": "Delete an item from the catalog"
      }
    }
  ]
}
