    {
      "name": "7. Handover to Delivery Agent",
      "item": [
        {
          "name": "Generate Handover OTP",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set delivery agent ID",
                  "pm.collectionVariables.set(\"delivery_agent_id\", \"674abc123def456789012345\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"OTP generated successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('otp');",
                  "    pm.expect(jsonData.otp).to.have.lengthOf(6);",
                  "    pm.collectionVariables.set(\"handover_otp\", jsonData.otp);",
                  "});",
                  "",
                  "pm.test(\"Expiry information provided\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('expiresIn');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "\"{{delivery_agent_id}}\""
            },
            "url": "{{order_base_url}}/{{order_id}}/generate-handover-otp"
          },
          "response": []
        },
        {
          "name": "Verify OTP and Complete Handover",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Handover successful\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData.message).to.include('handed over');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{order_id}}\",\n  \"deliveryAgentId\": \"{{delivery_agent_id}}\",\n  \"otp\": \"{{handover_otp}}\",\n  \"operatorId\": \"{{operator_id}}\"\n}"
            },
            "url": "{{order_base_url}}/handover"
          },
          "response": []
        },
        {
          "name": "Verify with Invalid OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error message returned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('error');",
                  "    pm.expect(jsonData.error).to.include('Invalid');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{order_id}}\",\n  \"deliveryAgentId\": \"{{delivery_agent_id}}\",\n  \"otp\": \"999999\",\n  \"operatorId\": \"{{operator_id}}\"\n}"
            },
            "url": "{{order_base_url}}/handover"
          },
          "response": []
        }
      ]
    },
    {
      "name": "8. Complete Operator Workflow",
      "description": "End-to-end workflow demonstrating all operator activities in sequence",
