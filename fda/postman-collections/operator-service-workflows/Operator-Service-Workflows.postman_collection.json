{
  "info": {
    "_postman_id": "operator-service-workflows-001",
    "name": "Operator Service Workflows",
    "description": "Complete workflow collection for restaurant operators to manage orders, inventory, packaging, and handover to delivery agents",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "operator_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "restaurant_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "menu_item_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "delivery_agent_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "handover_otp",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login Operator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.collectionVariables.set(\"auth_token\", jsonData.token);",
                  "});",
                  "",
                  "pm.test(\"Response has userId\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('userId');",
                  "    pm.collectionVariables.set(\"operator_id\", jsonData.userId);",
                  "});",
                  "",
                  "pm.test(\"User has Operator role\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.role).to.equal('Operator');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operator.pizzapalace@example.com\",\n  \"password\": \"Operator123!\"\n}"
            },
            "url": "{{auth_base_url}}/login"
          },
          "response": []
        },
        {
          "name": "Set Restaurant Context",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set the restaurant ID for the operator's restaurant",
                  "pm.collectionVariables.set(\"restaurant_id\", \"6738a123456789abcdef0001\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{order_base_url}}/api/restaurant/{{restaurant_id}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Order Management - View Orders",
      "item": [
        {
          "name": "Get Pending Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Save first order ID if exists\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.length > 0) {",
                  "        pm.collectionVariables.set(\"order_id\", jsonData[0].id);",
                  "    }",
