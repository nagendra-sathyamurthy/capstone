          "name": "Get Low Stock Items",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"All items have low stock\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.forEach(function(item) {",
                  "        if (item.minimumQuantity && item.quantityAvailable !== null) {",
                  "            pm.expect(item.quantityAvailable).to.be.at.most(item.minimumQuantity);",
                  "        }",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{order_base_url}}/api/operator/inventory/{{restaurant_id}}/low-stock"
          },
          "response": []
        }
