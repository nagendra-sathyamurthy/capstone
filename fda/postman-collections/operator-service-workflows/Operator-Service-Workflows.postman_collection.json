              "raw": "{\n  \"includeCutlery\": true,\n  \"includeNapkins\": true,\n  \"numberOfBags\": 2,\n  \"isFragile\": false,\n  \"packagedBy\": \"{{operator_id}}\"\n}"
            },
            "url": "{{order_base_url}}/{{order_id}}/package"
          },
          "response": []
        },
        {
          "name": "Step 7 - Generate Handover OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.otp) {",
                  "    pm.collectionVariables.set('handover_otp', jsonData.otp);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "\"{{delivery_agent_id}}\""
            },
            "url": "{{order_base_url}}/{{order_id}}/generate-handover-otp"
          },
          "response": []
        },
        {
          "name": "Step 8 - Verify OTP and Complete Handover",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
